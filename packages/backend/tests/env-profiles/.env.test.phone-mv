# ═══════════════════════════════════════════════════════════════════════════════
# BS-Commerce Backend — Test Profile: phone-mv
# Tests: AUTH_REQUIRED_IDENTIFIER=phone + MULTIVENDOR_ENABLED=true
# Phone-first marketplace (common in Bangladesh, India, SE Asia)
# Used by: node tests/run-e2e.mjs --profile phone-mv
# ═══════════════════════════════════════════════════════════════════════════════

# --- Database (test-isolated Postgres) ---
DATABASE_URI=postgresql://postgres:postgres@localhost:5433/bs_commerce_test
DATABASE_ID_TYPE=uuid

# --- Redis (test-isolated) ---
REDIS_URL=redis://localhost:6380

# --- Application ---
PAYLOAD_SECRET=test-secret-not-for-production
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (phone-only) ---
AUTH_REQUIRED_IDENTIFIER=phone
NEXT_PUBLIC_AUTH_REQUIRED_IDENTIFIER=phone
AUTH_REQUIRE_VERIFIED_EMAIL_FOR_LOGIN=false

# --- Ecommerce ---
GUEST_CHECKOUT_ENABLED=true
SUPPORTED_CURRENCIES=USD,BDT
DEFAULT_CURRENCY=BDT
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_SANDBOX=true

# --- Multivendor (ON) ---
MULTIVENDOR_ENABLED=true
VENDOR_AUTO_APPROVE=false
DEFAULT_COMMISSION_RATE=10
COMMISSION_STRATEGY=percentage
PARENT_ORDER_STATUS_STRATEGY=fulfillment-only
PAYOUT_SCHEDULE=biweekly
PAYOUT_HOLD_DAYS=7
PAYOUT_ADAPTER=manual-ledger

# --- Verification (phone-focused) ---
VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_STRATEGY=link
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=30
VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=10
VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10
PHONE_VERIFICATION_PROVIDER=console
PHONE_VERIFICATION_OTP_LENGTH=6
PHONE_VERIFICATION_OTP_EXPIRY=300

# --- Checkout verification gate ---
REQUIRE_VERIFIED_FOR_CHECKOUT=false

# --- Plugins ---
INVENTORY_ENABLED=true
LOW_STOCK_THRESHOLD=10
DISCOUNTS_ENABLED=true
REVIEWS_ENABLED=true
REVIEW_REQUIRES_APPROVAL=false
SHIPPING_MODEL=platform

# --- Test admin credentials ---
TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=AdminTest1234!
