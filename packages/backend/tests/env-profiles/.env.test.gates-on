# ═══════════════════════════════════════════════════════════════════════════════
# BS-Commerce Backend — Test Profile: gates-on
# All verification gates enabled for maximum strictness.
# Used by: node tests/run-e2e.mjs --profile gates-on
# ═══════════════════════════════════════════════════════════════════════════════

# --- Database (test-isolated Postgres) ---
DATABASE_URI=postgresql://postgres:postgres@localhost:5433/bs_commerce_test
DATABASE_ID_TYPE=uuid

# --- Redis (test-isolated) ---
REDIS_URL=redis://localhost:6380

# --- Application ---
PAYLOAD_SECRET=test-secret-not-for-production
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (gate ON) ---
AUTH_REQUIRED_IDENTIFIER=either
NEXT_PUBLIC_AUTH_REQUIRED_IDENTIFIER=either
AUTH_REQUIRE_VERIFIED_EMAIL_FOR_LOGIN=true

# --- Ecommerce ---
GUEST_CHECKOUT_ENABLED=false
SUPPORTED_CURRENCIES=USD,BDT
DEFAULT_CURRENCY=USD
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_SANDBOX=true

# --- Multivendor ---
MULTIVENDOR_ENABLED=false

# --- Verification ---
VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_STRATEGY=link
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=30
VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=10
VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10
PHONE_VERIFICATION_PROVIDER=console

# --- Checkout verification gate (ON for this profile) ---
REQUIRE_VERIFIED_FOR_CHECKOUT=true

# --- Plugins ---
INVENTORY_ENABLED=true
LOW_STOCK_THRESHOLD=10
DISCOUNTS_ENABLED=true
REVIEWS_ENABLED=true
REVIEW_REQUIRES_APPROVAL=false
SHIPPING_MODEL=platform

# --- Test admin credentials ---
TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=AdminTest1234!
