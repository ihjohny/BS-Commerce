{
  "name": "@bs-commerce/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types --import ./tests/_helpers/register-ts-resolve.mjs \"tests/unit/**/*.unit.test.ts\" \"tests/security/**/*.security.test.ts\"",
    "test:unit:cov": "c8 node --test --experimental-strip-types --import ./tests/_helpers/register-ts-resolve.mjs \"tests/unit/**/*.unit.test.ts\" \"tests/security/**/*.security.test.ts\"",
    "test:cov": "yarn test:unit:cov",
    "test:cov:check": "c8 check-coverage",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:e2e:safe": "node tests/run-e2e-safe.mjs",
    "test:e2e:safe:profile": "node tests/run-e2e-safe.mjs",
    "test:matrix:e2e:parallel": "node tests/run-all-profiles-safe-parallel-observe.mjs",
    "test:e2e:verification": "node tests/run-e2e.mjs --suite verification",
    "test:e2e:guest": "node tests/run-e2e.mjs --suite guest",
    "test:e2e:multivendor": "node tests/run-e2e.mjs --profile multivendor",
    "test:e2e:gates-on": "node tests/run-e2e.mjs --profile gates-on",
    "test:e2e:otp": "node tests/run-e2e.mjs --profile verification-otp --suite verification",
    "test:e2e:mv-guest": "node tests/run-e2e.mjs --profile mv-guest",
    "test:e2e:all-gates": "node tests/run-e2e.mjs --profile all-gates",
    "test:e2e:phone-only": "node tests/run-e2e.mjs --profile phone-only",
    "test:e2e:safe:phone-only": "node tests/run-e2e-safe.mjs --profile phone-only",
    "test:e2e:safe:phone-mv": "node tests/run-e2e-safe.mjs --profile phone-mv",
    "test:e2e:safe:parallel:observe": "node tests/run-e2e-parallel-observe.mjs",
    "test:all": "yarn typecheck && yarn test:unit && yarn test:e2e",
    "test:all:auto": "node tests/run-all-auto.mjs",
    "test:all-profiles": "node tests/run-all-profiles.mjs",
    "test:all-profiles:quick": "node tests/run-all-profiles.mjs --quick",
    "test:all-profiles:safe": "node tests/run-all-profiles-safe.mjs",
    "test:all-profiles:safe:quick": "node tests/run-all-profiles-safe.mjs --quick",
    "test:all-profiles:safe:parallel:observe": "node tests/run-all-profiles-safe-parallel-observe.mjs --max-parallel=2 --slot-start=4",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importMap",
    "payload": "payload",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create"
  },
  "dependencies": {
    "@bs-commerce/shared": "*",
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "^3.77.0",
    "@payloadcms/next": "^3.77.0",
    "@payloadcms/plugin-seo": "^3.77.0",
    "@payloadcms/richtext-lexical": "^3.77.0",
    "@payloadcms/translations": "^3.77.0",
    "graphql": "^16.10.0",
    "ioredis": "^5.9.3",
    "monaco-editor": "^0.55.1",
    "next": "15.4.11",
    "payload": "^3.77.0",
    "payload-oapi": "^0.2.5",
    "payloadcms-redis-plugin": "^0.2.17",
    "rate-limiter-flexible": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "c8": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.4.11",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
