{
  "all": true,
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/migrations/**",
    "src/**/payload-types.ts",
    "src/**/importMap.js",
    "src/app/api/**",
    "src/plugins/verification/adapters/phone-types.ts",
    "src/collections/categories/index.ts",
    "src/collections/media/index.ts",
    "src/collections/pages/index.ts",
    "src/components/admin/useAdminBranding.ts",
    "src/lib/admin-branding-chrome.ts"
  ],
  "reporter": ["text", "text-summary", "html", "lcov"],
  "report-dir": "coverage",
  "clean": true,
  "skip-full": false,
  "check-coverage": true,
  "lines": 90,
  "statements": 90,
  "branches": 90,
  "functions": 90
}
