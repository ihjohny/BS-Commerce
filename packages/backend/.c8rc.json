{
  "all": true,
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/migrations/**",
    "src/**/payload-types.ts",
    "src/**/importMap.js"
  ],
  "reporter": ["text", "text-summary", "html", "lcov"],
  "report-dir": "coverage",
  "clean": true,
  "skip-full": false,
  "check-coverage": false,
  "branches": 60,
  "lines": 60,
  "functions": 60,
  "statements": 60
}
