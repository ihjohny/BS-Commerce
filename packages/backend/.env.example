# ═══════════════════════════════════════════════════════════════════════════════
# BS-Commerce Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════
# Postgres (default)
DATABASE_URI=postgres://postgres:postgres@localhost:5432/bs-commerce

# MongoDB (alternative — swap adapter in payload.config.ts)
# DATABASE_URI=mongodb://localhost:27017/bs-commerce

# ═══════════════════════════════════════════════════
# REDIS
# Decision #16: Required for query caching + rate limiting
# ═══════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001
PAYLOAD_SECRET=change-this-to-a-long-random-secret-key

# ═══════════════════════════════════════════════════
# LOCALIZATION
# Decision #15: en + bn enabled from day one
# ═══════════════════════════════════════════════════
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn

# ═══════════════════════════════════════════════════
# MULTIVENDOR
# Decision #6: Both single + multivendor from day one via env var
# ═══════════════════════════════════════════════════
MULTIVENDOR_ENABLED=false
VENDOR_AUTO_APPROVE=false
VENDOR_KYC_REQUIRED=false
PRODUCT_REQUIRES_APPROVAL=false

# ═══════════════════════════════════════════════════
# ECOMMERCE
# ═══════════════════════════════════════════════════
SUPPORTED_CURRENCIES=USD,BDT
DEFAULT_CURRENCY=USD
GUEST_CHECKOUT_ENABLED=true

# ═══════════════════════════════════════════════════
# PAYMENTS
# Decision #13: SSLCommerz primary, Stripe as adapter alternative
# ═══════════════════════════════════════════════════
PAYMENT_PROVIDER=sslcommerz

# SSLCommerz (primary — Bangladeshi market)
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_SANDBOX=true

# Stripe (alternative — set PAYMENT_PROVIDER=stripe to use)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ═══════════════════════════════════════════════════
# SOCIAL LOGIN
# Decision #17: Google + Facebook via @papercup/payload-auth-plugin
# ═══════════════════════════════════════════════════
SOCIAL_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ═══════════════════════════════════════════════════
# COMMISSIONS
# Only active when MULTIVENDOR_ENABLED=true
# ═══════════════════════════════════════════════════
COMMISSION_STRATEGY=percentage
DEFAULT_COMMISSION_RATE=10

# ═══════════════════════════════════════════════════
# PAYOUTS
# Decision #14: Manual ledger by default (SSLCommerz doesn't support split payments)
# Only active when MULTIVENDOR_ENABLED=true
# ═══════════════════════════════════════════════════
PAYOUT_SCHEDULE=biweekly
PAYOUT_HOLD_DAYS=7
PAYOUT_ADAPTER=manual-ledger

# ═══════════════════════════════════════════════════
# SHIPPING
# ═══════════════════════════════════════════════════
SHIPPING_MODEL=platform

# ═══════════════════════════════════════════════════
# INVENTORY
# ═══════════════════════════════════════════════════
INVENTORY_ENABLED=true
LOW_STOCK_THRESHOLD=10

# ═══════════════════════════════════════════════════
# REVIEWS
# ═══════════════════════════════════════════════════
REVIEWS_ENABLED=true
REVIEW_REQUIRES_APPROVAL=false

# ═══════════════════════════════════════════════════
# NOTIFICATIONS
# ═══════════════════════════════════════════════════
EMAIL_ADAPTER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# Resend (alternative email adapter)
# EMAIL_ADAPTER=resend
# RESEND_API_KEY=re_...

# SMS via Twilio (optional)
# SMS_ADAPTER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+1234567890

# ═══════════════════════════════════════════════════
# ANALYTICS
# ═══════════════════════════════════════════════════
ANALYTICS_ENABLED=true

# ═══════════════════════════════════════════════════
# STORAGE (file uploads)
# Default: local filesystem. Use S3 for production.
# ═══════════════════════════════════════════════════
# STORAGE_ADAPTER=local

# S3 / Cloudflare R2 / MinIO (for production)
# STORAGE_ADAPTER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
