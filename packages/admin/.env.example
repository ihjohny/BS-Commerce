# Backend the Vite dev server proxies /api, /media, /uploads to.
BACKEND_URL=http://10.112.185.133:3010

# Direct browser-to-API base URL. Leave empty to use the dev proxy (recommended in dev).
# For a production build served from a different origin, set this to the API root
# and make sure the backend CORS/CSRF config trusts the admin panel's origin.
VITE_API_BASE_URL=

# Optional: storefront origin for document "Preview" links (e.g. pages).
VITE_STOREFRONT_URL=
