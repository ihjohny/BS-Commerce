      },
      "meta": {
        "title": {
          "en": "Fresh vegetables | Farm Greens",
          "bn": "তাজা সবজি | ফার্ম গ্রিন"
        },
        "description": {
          "en": "Hand-selected vegetables for Dhaka: crisp greens, gourds, and staples for curry, bharta, and salad.",
          "bn": "ঢাকা সরবরাহের জন্য বাছাই করা তাজা সবজি—রান্না ও স্যালাডে উপযুক্ত।"
        }
      }
    },
    {
