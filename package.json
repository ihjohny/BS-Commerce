{
  "name": "bs-commerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @bs-commerce/backend dev",
    "dev:host:sv": "node scripts/run-backend-host.mjs ../docker/.env.singlevendor 3000",
    "dev:host:mv": "node scripts/run-backend-host.mjs ../docker/.env.multivendor 3010",
    "seed:frontend-demo": "node scripts/seed-frontend-demo.mjs",
    "reset:local-admin-password": "node scripts/reset-local-admin-password.mjs",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=1.22.0"
  }
}
