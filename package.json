{
  "name": "bs-commerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @bs-commerce/backend dev",
    "dev:host:sv": "node scripts/run-backend-host.mjs ../docker/.env.singlevendor 3000",
    "dev:host:mv": "node scripts/run-backend-host.mjs ../docker/.env.multivendor 4000",
    "seed:storefront-config": "node scripts/seed-storefront-config.mjs",
    "seed:storefront-config:sv": "node scripts/seed-storefront-config.mjs --env-file ../docker/.env.singlevendor --stacks sv",
    "seed:storefront-config:mv": "node scripts/seed-storefront-config.mjs --env-file ../docker/.env.multivendor --stacks mv",
    "seed:frontend-demo": "node scripts/seed-frontend-demo.mjs",
    "seed:frontend-demo:produce-bd": "node scripts/seed-client-demo-produce-bd.mjs",
    "seed:frontend-demo:produce-bd:images": "node scripts/download-produce-demo-images.mjs",
    "reset:local-admin-password": "node scripts/reset-local-admin-password.mjs",
    "demo:sync-passwords": "node scripts/sync-all-user-passwords.mjs",
    "demo:bootstrap": "node scripts/run-client-demo-bootstrap.mjs",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=1.22.0"
  }
}
